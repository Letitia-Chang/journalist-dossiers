{
  "name": "press-dossier-server",
  "version": "1.0.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:create": "node-pg-migrate create --",
    "migrate:up": "node -r dotenv/config node_modules/.bin/node-pg-migrate up",
    "migrate:down": "node -r dotenv/config node_modules/.bin/node-pg-migrate down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:reset": "ts-node --transpile-only src/scripts/demoReset.ts",
    "lint": "eslint .",
    "start:prod": "node -r dotenv/config node_modules/.bin/node-pg-migrate up && node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "googleapis": "^190.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.2"
    }
  }
}
