# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Render, Supabase, or local).
DATABASE_URL=postgresql://user:password@localhost:5432/press_dossier
# Long random string used to sign login tokens. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# Claude API key (https://console.anthropic.com). Without it, AI features are disabled.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Browser origin of the client, used for CORS. Several can be comma-separated; invite links use the first.
FRONTEND_URL=http://localhost:5173
# Behind a reverse proxy, so sign-in and demo limits see the real address (always on in demo mode).
# TRUST_PROXY=true
# If a CDN is in front of that proxy too (Render uses Cloudflare).
# CLIENT_IP_HEADER=cf-connecting-ip

# ── Company setup (all optional) ─────────────────────────────────────────────
# Path to a company.config.json (see company.config.example.json). Seeds the company
# profile on first boot only; edits made in the app are never overwritten.
# COMPANY_CONFIG_PATH=./company.config.json
# Re-apply the file on every boot instead of only the first.
# COMPANY_CONFIG_SYNC=false
# Create the first owner account on boot (instead of using the setup screen).
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=at-least-8-characters
# ADMIN_NAME=Admin

# ── Gmail drafts (optional) ──────────────────────────────────────────────────
# Create an OAuth client (Web application) in Google Cloud and enable the Gmail API.
# Redirect URI must match GOOGLE_REDIRECT_URI exactly. Scope used: gmail.compose (the app only creates drafts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ── Polite crawling ──────────────────────────────────────────────────────────
# How we identify ourselves when fetching publisher pages. Give site owners a way to reach you.
# BOT_NAME=PressDossierBot
# BOT_CONTACT_URL=https://example.com/about-this-bot
# BOT_USER_AGENT=            # overrides both of the above

# ── Public demo (optional) ───────────────────────────────────────────────────
# DEMO_MODE=true gives each visitor a private, expiring copy of a fictional company ("Lumen Grid").
# It refuses to run if the database holds a real organization.
# In demo mode: visitors sign in with one click, Gmail and web discovery are disabled, and
# live Claude calls are rate-limited (saved results are shown once a limit is reached).
# DEMO_MODE=true
# DEMO_AI_PER_HOUR=5       # live calls per visitor (IP) per clock hour
# DEMO_AI_PER_DAY=150      # live calls across all visitors per UTC day
# DEMO_SANDBOX_HOURS=24    # how long each visitor's private sandbox lives
# Delete every sandbox: npm run demo:reset --prefix server

# ── AI ───────────────────────────────────────────────────────────────────────
# Claude model for all AI steps. It must support adaptive thinking.
# ANTHROPIC_MODEL=claude-opus-4-8
